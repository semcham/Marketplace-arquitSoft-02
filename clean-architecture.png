<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 620" width="1000" height="620" font-family="Arial, Helvetica, sans-serif" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <rect width="1000" height="620" fill="#ffffff"/>
  <text x="500" y="34" text-anchor="middle" font-size="22" font-weight="bold" fill="#1f2937">Clean Architecture - Marketplace de Productos para Mascotas</text>

  <!-- Anillos -->
  <circle cx="300" cy="330" r="270" fill="#fde8d0" stroke="#d97706" stroke-width="2"/>
  <circle cx="300" cy="330" r="210" fill="#d9ecfb" stroke="#2563eb" stroke-width="2"/>
  <circle cx="300" cy="330" r="150" fill="#dcf5e3" stroke="#16a34a" stroke-width="2"/>
  <circle cx="300" cy="330" r="90" fill="#f9d9e0" stroke="#be185d" stroke-width="2"/>

  <!-- Etiquetas de anillos -->
  <text x="300" y="88" text-anchor="middle" font-size="17" font-weight="bold" fill="#92400e">Infraestructura</text>
  <text x="300" y="107" text-anchor="middle" font-size="12" fill="#92400e">BD · API · Pasarela de pago</text>

  <text x="300" y="148" text-anchor="middle" font-size="17" font-weight="bold" fill="#1e40af">Presentación</text>
  <text x="300" y="167" text-anchor="middle" font-size="12" fill="#1e40af">Angular · Controladores API</text>

  <text x="300" y="208" text-anchor="middle" font-size="17" font-weight="bold" fill="#166534">Aplicación</text>
  <text x="300" y="227" text-anchor="middle" font-size="12" fill="#166534">Casos de uso</text>

  <text x="300" y="326" text-anchor="middle" font-size="17" font-weight="bold" fill="#9d174d">Dominio</text>
  <text x="300" y="346" text-anchor="middle" font-size="12" fill="#9d174d">Entidades y</text>
  <text x="300" y="361" text-anchor="middle" font-size="12" fill="#9d174d">reglas de negocio</text>

  <!-- Flecha de dependencias -->
  <defs>
    <marker id="arrow" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="#111827"/>
    </marker>
  </defs>

  <!-- Leyenda -->
  <g transform="translate(610,95)">
    <text x="0" y="0" font-size="16" font-weight="bold" fill="#1f2937">Capas</text>

    <rect x="0" y="18" width="18" height="18" rx="3" fill="#f9d9e0" stroke="#be185d" stroke-width="2"/>
    <text x="28" y="32" font-size="14" font-weight="bold" fill="#1f2937">Dominio</text>
    <text x="28" y="50" font-size="12" fill="#4b5563">Productos, pedidos, pagos y sus reglas.</text>

    <rect x="0" y="78" width="18" height="18" rx="3" fill="#dcf5e3" stroke="#16a34a" stroke-width="2"/>
    <text x="28" y="92" font-size="14" font-weight="bold" fill="#1f2937">Aplicación</text>
    <text x="28" y="110" font-size="12" fill="#4b5563">Casos de uso e interfaces (puertos).</text>

    <rect x="0" y="138" width="18" height="18" rx="3" fill="#d9ecfb" stroke="#2563eb" stroke-width="2"/>
    <text x="28" y="152" font-size="14" font-weight="bold" fill="#1f2937">Presentación</text>
    <text x="28" y="170" font-size="12" fill="#4b5563">Interfaz Angular y endpoints REST.</text>

    <rect x="0" y="198" width="18" height="18" rx="3" fill="#fde8d0" stroke="#d97706" stroke-width="2"/>
    <text x="28" y="212" font-size="14" font-weight="bold" fill="#1f2937">Infraestructura</text>
    <text x="28" y="230" font-size="12" fill="#4b5563">Base de datos, caché y adaptadores externos.</text>

    <line x1="0" y1="275" x2="60" y2="275" stroke="#111827" stroke-width="3" marker-end="url(#arrow)"/>
    <text x="72" y="280" font-size="14" font-weight="bold" fill="#1f2937">Regla de dependencia</text>
    <text x="0" y="305" font-size="12" fill="#4b5563">Las dependencias apuntan siempre hacia el</text>
    <text x="0" y="321" font-size="12" fill="#4b5563">dominio: las capas externas conocen a las</text>
    <text x="0" y="337" font-size="12" fill="#4b5563">internas, nunca al revés.</text>
  </g>
</svg>
